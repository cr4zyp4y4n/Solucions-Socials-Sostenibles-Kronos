# Portal Firma — variables (copiar a .env.local; no commitear)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS OTP + API /api/firma/sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_API_BASE=https://api.twilio.com

# Debe coincidir con Kronos (.env FIRMA_SMS_API_SECRET)
FIRMA_SMS_API_SECRET=

# ---------------------------------------------------------------------------
# Sello electrónico PAdES (FNMT persona jurídica) — obligatorio para firmar
# Exportar cada sello a .p12 y:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("sello.p12"))
#
# Por entidad. Si el Base64 supera 5000 chars (límite Netlify), partirlo:
#   KRONOS_SEAL_P12_BASE64_SOLUCIONS_1, _2, _3…  (el código los concatena)
KRONOS_SEAL_P12_BASE64_SOLUCIONS_1=
KRONOS_SEAL_P12_BASE64_SOLUCIONS_2=
KRONOS_SEAL_P12_BASE64_SOLUCIONS_3=
KRONOS_SEAL_P12_PASS_SOLUCIONS=
KRONOS_SEAL_P12_BASE64_MENJAR_1=
KRONOS_SEAL_P12_BASE64_MENJAR_2=
KRONOS_SEAL_P12_BASE64_MENJAR_3=
KRONOS_SEAL_P12_PASS_MENJAR=
#
# Fallback único (también admite _1/_2/_3):
KRONOS_SEAL_P12_BASE64=
KRONOS_SEAL_P12_PASS=
# ---------------------------------------------------------------------------
